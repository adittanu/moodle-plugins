<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/siteframe/db" VERSION="2026071200" COMMENT="SiteFrame activity module tables">
    <TABLES>
        <TABLE NAME="siteframe" COMMENT="SiteFrame activity instances">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="FK to course"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Activity name"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" COMMENT="Activity description"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="false" DEFAULT="0"/>
                <FIELD NAME="url" TYPE="text" NOTNULL="true" COMMENT="iframe source URL"/>
                <FIELD NAME="displaymode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="inline" COMMENT="inline, fullscreen, responsive"/>
                <FIELD NAME="height" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="iframe height px, 0=auto"/>
                <FIELD NAME="width" TYPE="varchar" LENGTH="10" NOTNULL="true" DEFAULT="100%"/>
                <FIELD NAME="scrolling" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="auto"/>
                <FIELD NAME="extra_allowed" TYPE="text" NOTNULL="false" COMMENT="JSON extra allowed URLs"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
